{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runner-fleet-dashboard",
  // NO WORKER IS DEPLOYED (2026-11-23). The dashboard runs on AWS Lambda (src/aws/); the Cloudflare
  // Worker and its D1 database were retired (issue #28). This file stays for two things only:
  //   vars   the app's settings, copied into the Lambda package by scripts/build-lambda.mjs
  //   types  `npm run types` (wrangler types) generates the runtime types the code is written against
  // Do not add bindings or triggers back: nothing deploys this file.
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Comma-separated "org:<name>" / "repo:<owner>/<name>" scopes to poll for runners.
    // Personal-account self-hosted runners only exist per-repo, so list them explicitly.
    "POLL_SCOPES": "org:Lurking-Walrus",
    // How many minutes a job can occupy a runner before it's flagged as long-running.
    "LONG_RUNNING_JOB_MINUTES": "60",
    // How many minutes telemetry can go stale before it's flagged.
    "TELEMETRY_STALE_MINUTES": "10",
    // How many minutes a runner can sit offline before it's flagged as stuck
    // (as opposed to a one-off blip). Re-flagged hourly for as long as it stays offline.
    // Consecutive failed polls (the cron runs every 2 min) before a poller_failing alert is raised.
    // Re-raised every 6 hours while it stays broken.
    "POLLER_FAILURE_ALERT_RUNS": "3",
    "OFFLINE_STUCK_MINUTES": "15",
    // Polls in a row GitHub must report a runner offline before the dashboard shows it offline.
    // On 2026-11-24 GitHub's runners API reported the whole fleet offline in windows of up to ~6 min
    // (two polls) while the runners were running jobs, so 3 (6-8 min); a real outage is still
    // flagged well inside OFFLINE_STUCK_MINUTES.
    "OFFLINE_CONFIRM_POLLS": "3",
    // Max completed workflow runs whose jobs the history sync fetches per 10-minute tick (one
    // GitHub call each). Keeps the sync inside the per-invocation subrequest limit; any backlog
    // carries over to the next tick.
    "HISTORY_SYNC_MAX_RUNS": "20",
    // Days of raw per-job and per-step timings kept in D1 (job_history, job_steps). Steps come with
    // the jobs payload the sync already fetches, so they cost no extra GitHub calls; this bounds
    // the storage and the rows D1 reads when a view aggregates them.
    "JOB_RETENTION_DAYS": "14",
    // Max GitHub calls the 2-minute poll may spend matching busy runners to their jobs. The scan
    // lists each repo's in-progress AND queued runs (a run stays
    // "queued" while any job waits), most recently pushed repos first, and stops when every busy runner is matched; past this cap the rest show
    // as busy with an unidentified job instead of the whole poll failing on the subrequest limit.
    "POLL_MAX_GITHUB_CALLS": "40",
    // The queued-jobs snapshot (every 10 minutes): GitHub calls it may spend, and how many repos
    // (most recently pushed first) it reads. Over budget it reports a partial count, not an error.
    "QUEUE_MAX_GITHUB_CALLS": "35",
    "QUEUE_MAX_REPOS": "20"
  }
}
