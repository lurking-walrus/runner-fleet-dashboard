{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "worker-configuration.d.ts"],
  // The AWS entry point runs on Node, not workerd: tsconfig.test.json checks it with Node's types.
  "exclude": ["src/aws"]
}
